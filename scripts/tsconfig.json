{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020", "DOM"],
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "paths": {
      "../packages/shared/src/*": ["../packages/shared/src/*"]
    }
  },
  "include": ["./**/*.ts", "../packages/shared/src/**/*.ts"],
  "exclude": ["../node_modules"]
}
