# ── SkillLens AI — Environment Variables ─────────────────────────────────────
# Copy this file to .env and fill in real values. Never commit .env to git.

# ── MongoDB ──────────────────────────────────────────────────────────────────
MONGO_ROOT_USER=skilllens
MONGO_ROOT_PASSWORD=CHANGE_ME_STRONG_PASSWORD
MONGO_APP_PASSWORD=CHANGE_ME_APP_PASSWORD
# MONGO_URI is assembled by docker-compose from the above values.
# For local development outside Docker, set it explicitly:
# MONGO_URI=mongodb://skilllens:CHANGE_ME@localhost:27017/skilllens?authSource=admin

# ── API ───────────────────────────────────────────────────────────────────────
APP_ENV=development          # development | production
JWT_SECRET=CHANGE_ME_AT_LEAST_32_CHARS
JWT_ACCESS_EXPIRES_MINUTES=15
JWT_REFRESH_EXPIRES_DAYS=7

# Cookie security — set false ONLY in development (APP_ENV=development).
# NEVER set false in production. See README § Security.
COOKIE_SECURE=false

# CORS — comma-separated list of allowed origins (no trailing slash)
CORS_ORIGINS=http://localhost:3000

# Upload limits
UPLOAD_MAX_SIZE_MB=10
UPLOAD_MAX_DIMENSION_PX=4000
UPLOAD_MAX_MEGAPIXELS=16
UPLOAD_MAX_PDF_PAGES=5
UPLOAD_RATE_LIMIT_PER_HOUR=20
UPLOAD_PROCESSING_TIMEOUT_SECONDS=20

# Retention
RESUME_RETENTION_DAYS=30
TEMP_FILE_DIR=/tmp/skilllens_uploads

# ── Frontend ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Seed script ───────────────────────────────────────────────────────────────
# Set MONGO_URI before running scripts/seed.py.
# Example:
#   export MONGO_URI=mongodb://skilllens:CHANGE_ME@localhost:27017/skilllens?authSource=admin
#   python scripts/seed.py
# Demo credentials seeded by the script:
#   Email:    demo@skilllens.ai
#   Password: DemoPassword2026!
